# Generate each value independently with: openssl rand -hex 32
JWT_SECRET=
CSRF_SECRET=

# Required by Prisma; set this to your PostgreSQL connection string.
DATABASE_URL=

# Gmail SMTP settings used to send account invitation emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Use the Gmail address and a Google App Password (not the normal account password).
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to "Tiako dia Tiako" <SMTP_USER>.
SMTP_FROM=

# Set these locally only when running the initial admin seeder.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
